 启动！见证奇迹的时刻 🎇\n",[45,113,115,117,120],{"class":47,"line":114},9,[45,116,97],{"class":58},[45,118,119],{"class":62}," run",[45,121,122],{"class":62}," dev\n",[14,124,125,126,129],{},"打开浏览器访问 ",[31,127,128],{},"http:\u002F\u002Flocalhost:3000","，是不是感觉世界美好了很多？🥰",[23,131,133],{"id":132},"目录结构井井有条","目录结构：井井有条 📁",[14,135,136],{},"Nuxt 3 的约定大于配置理念，让你的代码库天生就有令人极度舒适的结构：",[36,138,143],{"className":139,"code":141,"language":142,"meta":41},[140],"language-text","my-awesome-project\u002F\n├── 🏠 app.vue          # 你的总司令部：主应用入口组件\n├── 🗺️ pages\u002F           # 页面客栈：基于文件系统的自动路由，超省心！\n├── 🧱 components\u002F      # 积木仓库：组件文件（全自动导入，爽到飞起）\n├── 🖼️ layouts\u002F         # 门面担当：布局文件，控制全站统一 UI\n├── 🔌 plugins\u002F         # 外挂中心：全局插件注册地\n├── ⚙️ nuxt.config.ts   # 大总管：核心配置文件\n└── 📝 content\u002F         # 创作空间：使用 Nuxt Content 驱动的内容源（比如这篇文章！）\n","text",[31,144,141],{"__ignoreMap":41},[23,146,148],{"id":147},"自动路由路痴的福音-️","自动路由：路痴的福音 🗺️",[14,150,151,152,155,156,159],{},"再也不用手写 ",[31,153,154],{},"router.js"," 了！Nuxt 3 会像魔法一样 ✨，根据 ",[31,157,158],{},"pages\u002F"," 目录里的文件自动生成路由表：",[161,162,163,179],"table",{},[164,165,166],"thead",{},[167,168,169,173,176],"tr",{},[170,171,172],"th",{},"文件路径 📂",[170,174,175],{},"自动匹配的 URL 🔗",[170,177,178],{},"描述 💡",[180,181,182,198,213],"tbody",{},[167,183,184,190,195],{},[185,186,187],"td",{},[31,188,189],{},"pages\u002Findex.vue",[185,191,192],{},[31,193,194],{},"\u002F",[185,196,197],{},"你的大门（首页）",[167,199,200,205,210],{},[185,201,202],{},[31,203,204],{},"pages\u002Fabout.vue",[185,206,207],{},[31,208,209],{},"\u002Fabout",[185,211,212],{},"你的往事（关于我们）",[167,214,215,220,225],{},[185,216,217],{},[31,218,219],{},"pages\u002Fposts\u002F[slug].vue",[185,221,222],{},[31,223,224],{},"\u002Fposts\u002F:slug",[185,226,227],{},"动态路由？加个方括号轻松搞定！🎯",[23,229,231],{"id":230},"自动导入懒人最高境界","自动导入：懒人最高境界 🥱",[14,233,234,235,238],{},"这个特性绝对是 Nuxt 3 最让人上瘾的毒药！组件、组合式函数 (Composables)、Vue API... 全都 ",[18,236,237],{},"自！动！导！入！"," 🤯",[36,240,244],{"className":241,"code":242,"language":24